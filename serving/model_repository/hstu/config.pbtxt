name: "hstu"
backend: "python"
max_batch_size: 128

input [
  { name: "item_ids"   data_type: TYPE_INT64 dims: [ -1 ] allow_ragged_batch: true },
  { name: "timestamps" data_type: TYPE_INT64 dims: [ -1 ] allow_ragged_batch: true }
]
output [
  { name: "top_items"     data_type: TYPE_INT64 dims: [ 10 ] },
  { name: "top_movie_ids" data_type: TYPE_INT64 dims: [ 10 ] },
  { name: "top_scores"    data_type: TYPE_FP32  dims: [ 10 ] },
  { name: "batch_size"    data_type: TYPE_INT32 dims: [ 1 ] }
]

# Requests have different history lengths, so they cannot be stacked into one
# dense tensor. allow_ragged_batch lets the dynamic batcher group them anyway;
# execute() receives the group and concatenates it into one jagged batch.
dynamic_batching {
  max_queue_delay_microseconds: 2000
  preferred_batch_size: [ 32, 64, 128 ]
}

instance_group [ { kind: KIND_GPU count: 1 gpus: [ 0 ] } ]

parameters { key: "top_k" value: { string_value: "10" } }
parameters { key: "impl"  value: { string_value: "triton" } }
